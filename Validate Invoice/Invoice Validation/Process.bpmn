            <uipath:input name="taskTitle" type="string" value="=&#34;Validate - &#34; + vars.response.FullName" />
            <uipath:input name="assignmentCriteria" type="string" value="user" />
            <uipath:input name="recipient" type="json"><![CDATA[{"Type":2,"Value":"binojpv509@gmail.com"}]]></uipath:input>
            <uipath:input name="priority" type="string" value="Medium" />
            <uipath:input name="labels" type="string" />
            <uipath:input name="actionCatalogName" type="string" />
            <uipath:input name="enableActionableNotifications" type="boolean" value="false" />
