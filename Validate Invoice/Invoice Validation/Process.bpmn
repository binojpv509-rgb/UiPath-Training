        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>edge_Gateway_EoG3gP-Activity_LSFkTX</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_aQOl2h" name="move invoice to success">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartJob" version="v2" />
