    <bpmn:userTask id="Activity_LSFkTX" name="human validation">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Actions.HITL" version="v2" />
          <uipath:context>
            <uipath:input name="name" type="string" value="=bindings.bF7Jvu1IX" />
            <uipath:input name="folderPath" type="string" value="=bindings.bsOcq5F0X" />
