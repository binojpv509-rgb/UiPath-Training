    <bpmn:sequenceFlow id="edge_Gateway_EoG3gP-Activity_aQOl2h" name="Success" sourceRef="Gateway_EoG3gP" targetRef="Activity_aQOl2h">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vars.status.ToLower() == "success"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
