    <bpmn:serviceTask id="Activity_aDtXfk" name="Download and extract invoice data">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartJob" version="v2" />
          <uipath:context>
            <uipath:input name="name" type="string" value="=bindings.bZh5ZF4jp" />
            <uipath:input name="folderPath" type="string" value="=bindings.bjR8C1tGA" />
            <uipath:input name="_label" type="string" value="RPA Workflow" />
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"fileURL":{"type":"string"}},"required":[]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"fileURL":"=vars.response.URL"}]]></uipath:input>
          <uipath:output name="Error" type="jsonSchema" source="=Error" var="error" />
          <uipath:output name="outInvoiceDate" type="string" source="=outInvoiceDate" var="outInvoiceDate" />
          <uipath:output name="outInvoiceVendorName" type="string" source="=outInvoiceVendorName" var="outInvoiceVendorName" />
          <uipath:output name="outInvoiceAmount" type="number" source="=outInvoiceAmount" var="outInvoiceAmount" />
          <uipath:output name="outInvoiceNumber" type="string" source="=outInvoiceNumber" var="outInvoiceNumber" />
          <uipath:output name="remoteFile" type="file" source="=remoteFile" var="remoteFile" target="=orchestrator.JobAttachments" />
        </uipath:activity>
      </bpmn:extensionElements>
      <bpmn:incoming>edge_Event_start-Activity_aDtXfk</bpmn:incoming>
      <bpmn:outgoing>edge_Activity_aDtXfk-Activity_SRIaBl</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_SRIaBl" name="Validate data data extraction">
      <bpmn:extensionElements>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgentJob" version="v2" />
          <uipath:context>
            <uipath:input name="name" type="string" value="=bindings.bTIyzqRKx" />
            <uipath:input name="folderPath" type="string" value="=bindings.bb577quy7" />
            <uipath:input name="_label" type="string" value="Agent" />
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"invoice_amount":{"type":"string"},"invoice_date":{"type":"string"},"invoice_number":{"type":"string"},"vendor_name":{"type":"string"}},"required":[]}]]></uipath:inputSchema>
          </uipath:context>
          <uipath:input name="JobArguments" type="json" target="bodyField"><![CDATA[{"invoice_amount":"=vars.outInvoiceAmount","invoice_date":"=vars.outInvoiceDate","invoice_number":"=vars.outInvoiceNumber","vendor_name":"=vars.outInvoiceVendorName"}]]></uipath:input>
          <uipath:output name="Error" type="jsonSchema" source="=Error" var="error2" />
          <uipath:output name="Status" type="string" source="=Status" var="status" />
          <uipath:output name="Reason" type="string" source="=Reason" var="reason" />
        </uipath:activity>
